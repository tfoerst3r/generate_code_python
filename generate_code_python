# :command.command_functions

# :command.parse_requirements
parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        generate_code_python_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action="root"

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      # :flag.case
      --holder)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--holder']="$2"
          shift
          shift
        else
          printf "%s\n" "--holder requires an argument: --holder LIC_HOLDER" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --email)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--email']="$2"
          shift
          shift
        else
          printf "%s\n" "--email requires an argument: --email LIC_EMAIL" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --git)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--git']="$2"
          shift
          shift
        else
          printf "%s\n" "--git requires an argument: --git GIT_REPO" >&2
          exit 1
        fi
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        # :argument.case
        if [[ -z ${args['project_name']+x} ]]; then
          args['project_name']=$1
          shift
        # :argument.case
        elif [[ -z ${args['package_name']+x} ]]; then
          args['package_name']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  # :command.required_args_filter
  if [[ -z ${args['project_name']+x} ]]; then
    printf "missing required argument: PROJECT_NAME\nusage: generate_code_python PROJECT_NAME [PACKAGE_NAME] [OPTIONS]\n" >&2

    exit 1
  fi

  # :command.default_assignments
  [[ -n ${args['--holder']:-} ]] || args['--holder']="tfoerst3r"
  [[ -n ${args['--email']:-} ]] || args['--email']="32761865+tfoerst3r@users.noreply.github.com"

}

# :command.initialize
initialize() {
  declare -g version="0.1.0"
  set -e

}

# :command.run
run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "root") root_command ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  # :command.start
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
fi
