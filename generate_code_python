    fi

    if [[ $_default_lic == 1 ]]; then

        FILETYPE="${_args_lic_arr[0]}"
        LICENSE="${_args_lic_arr[1]}"
        LIC_HOLDER="$DEFAULT_LIC_HOLDER"
        LIC_EMAIL="$DEFAULT_LIC_EMAIL"
